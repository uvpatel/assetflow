# Neon Serverless PostgreSQL Credentials
DATABASE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# Data Seeding Configuration
SEED_DATA=false
SEED_ADMIN_PASSWORD=<local-demo-password>

# Test Database Connection (Isolated Integration Testing)
TEST_DATABASE_URL=jdbc:postgresql://<neon-test-host>/<test-database>?sslmode=require
TEST_DATABASE_USERNAME=<neon-test-username>
TEST_DATABASE_PASSWORD=<neon-test-password>

# Application Server Port
PORT=5000
